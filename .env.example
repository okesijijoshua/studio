# ==========================================
# PAYSTACK KEYS
# ==========================================
# Secret / Private Key (Starts with sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=

# Public origin used for the Paystack return URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Firebase Admin SDK: on Firebase App Hosting, the runtime service account
# is used automatically. For other hosts, supply service account JSON here.
# FIREBASE_SERVICE_ACCOUNT=

# ==========================================
# EMAIL NOTIFICATIONS (Nodemailer)
# ==========================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=
MAIL_TO_ADDRESS=

